# Database URL
DATABASE_URL="postgresql://user:password@localhost:5432/studyasan"

# JWT Secret
JWT_SECRET="your-jwt-secret-key"

# Server Port
PORT=3000

# AWS S3 Configuration
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="your-bucket-name"

# Google Meet Integration
# Follow instructions in google-meet-scheduler.gs to deploy and get the URL
GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"
GOOGLE_SCRIPT_API_KEY="your-secret-api-key-here"

# Janus WebRTC Gateway Configuration
JANUS_HTTP_API="https://janus.studyasan.com/api"
JANUS_ADMIN_KEY="CHANGE_THIS_TO_A_STRONG_SECRET"

# SMTP Configuration (Brevo / Sendinblue / Custom SMTP)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="b74dcd001@smtp-brevo.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="no-reply@studyasan.com"

# Firebase Admin SDK (for push notifications)
# Download service account JSON from Firebase Console:
# Project Settings > Service Accounts > Generate New Private Key
# Then stringify the entire JSON object and paste it here
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

